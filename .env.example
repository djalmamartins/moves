# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/erp

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=moves
DB_USER=moves
DB_PASS=

# Legacy database aliases (remove after all consumers use DB_* variables)
MOVESOS_ENV=development
MOVESOS_DB_HOST=127.0.0.1
MOVESOS_DB_PORT=3306
MOVESOS_DB_NAME=moves
MOVESOS_DB_USER=moves
MOVESOS_DB_PASS=

# Banco Inter (mTLS)
INTER_API_URL=https://cdpj.partners.bancointer.com.br
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_SCOPE="extrato.read boleto-cobranca.read"
INTER_CERT_PATH=storage/cert/Certificado.crt
INTER_KEY_PATH=storage/cert/chave.key

# Automated tests (the database name must end in _test)
MOVESOS_TEST_DB_HOST=127.0.0.1
MOVESOS_TEST_DB_PORT=3306
MOVESOS_TEST_DB=moves_test
MOVESOS_TEST_DB_USER=root
MOVESOS_TEST_DB_PASS=
# Optional for local XAMPP/MariaDB installations that expose only a socket:
MOVESOS_TEST_DB_SOCKET=
