{
  "name": "djalmamartins/moves-os",
  "description": "Moves platform for Studio, Web, ERP and resident applications",
  "license": "proprietary",
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "Djalma Martins",
      "email": "djalma-martins@hotmail.com",
      "homepage": "https://www.moves.com.br",
      "role": "Project manager and developer"
    }
  ],
  "config": {
    "vendor-dir": "vendor"
  },
  "autoload": {
    "psr-4": {
      "Source\\": "source/"
    },
    "files": [
      "source/Boot/Config.php",
      "source/Boot/Helpers.php",
      "source/Boot/Connection.php",
      "source/Boot/Settings.php",
      "source/Services/Minify/Web.php",
      "source/Services/Minify/App.php",
      "source/Services/Minify/Erp.php",
      "source/Services/Minify/Studio.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "MovesOSTests\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "phpmailer/phpmailer": "6.*",
    "movescode/view": "^1.0",
    "movescode/compress": "^1.0",
    "movescode/storage": "^1.0",
    "movescode/cropper": "^1.0",
    "movescode/seo": "^2.0",
    "movescode/pager": "^1.0",
    "movescode/router": "^1.1",
    "monolog/monolog": "3.*",
    "ext-intl": "*",
    "dompdf/dompdf": "^3.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "test": "@php tests/run.php --colors=always",
    "test:unit": "@php tests/run.php --testsuite unit --colors=always",
    "test:integration": "@php tests/run.php --testsuite integration --colors=always"
  }
}
